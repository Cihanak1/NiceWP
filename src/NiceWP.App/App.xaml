<?xml version='1.0' encoding='utf-8'?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="using:Microsoft.UI.Xaml.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NiceWP.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush Color="#191C20" x:Key="ControlCanvasBrush" />
                    <SolidColorBrush Color="#22262B" x:Key="ControlSurfaceBrush" />
                    <SolidColorBrush Color="#363C43" x:Key="ControlStrokeBrush" />
                    <SolidColorBrush Color="#59C8DF" x:Key="ControlAccentBrush" />
                    <SolidColorBrush Color="#272C32" x:Key="LibraryCardSurfaceBrush" />
                    <SolidColorBrush Color="#454D57" x:Key="LibraryCardStrokeBrush" />
                    <SolidColorBrush Color="#59C8DF" x:Key="AccentFillColorDefaultBrush" />
                    <SolidColorBrush Color="#50B7CD" x:Key="AccentFillColorSecondaryBrush" />
                    <SolidColorBrush Color="#48A7BC" x:Key="AccentFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#59C8DF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush Color="#F3F4F6" x:Key="ControlCanvasBrush" />
                    <SolidColorBrush Color="#FFFFFF" x:Key="ControlSurfaceBrush" />
                    <SolidColorBrush Color="#D8DDE3" x:Key="ControlStrokeBrush" />
                    <SolidColorBrush Color="#006C82" x:Key="ControlAccentBrush" />
                    <SolidColorBrush Color="#FFFFFF" x:Key="LibraryCardSurfaceBrush" />
                    <SolidColorBrush Color="#CCD3DB" x:Key="LibraryCardStrokeBrush" />
                    <SolidColorBrush Color="#006C82" x:Key="AccentFillColorDefaultBrush" />
                    <SolidColorBrush Color="#08778C" x:Key="AccentFillColorSecondaryBrush" />
                    <SolidColorBrush Color="#158497" x:Key="AccentFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#006C82" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}" x:Key="ControlCanvasBrush" />
                    <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}" x:Key="ControlSurfaceBrush" />
                    <SolidColorBrush Color="{ThemeResource SystemColorWindowTextColor}" x:Key="ControlStrokeBrush" />
                    <SolidColorBrush Color="{ThemeResource SystemColorHighlightColor}" x:Key="ControlAccentBrush" />
                    <SolidColorBrush Color="{ThemeResource SystemColorWindowColor}" x:Key="LibraryCardSurfaceBrush" />
                    <SolidColorBrush Color="{ThemeResource SystemColorWindowTextColor}" x:Key="LibraryCardStrokeBrush" />
                    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="Border" x:Key="ControlSurfaceStyle">
                <Setter Property="Background" Value="{ThemeResource ControlSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="HealthHealthyStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ControlAccentBrush}" />
            </Style>
            <Style x:Key="HealthWarningStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
            <Style x:Key="HealthAttentionStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="HealthNeutralStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="ActiveChipTextStyle">
                <Setter Property="Foreground" Value="{ThemeResource ControlAccentBrush}" />
            </Style>
            <Style TargetType="TextBlock" x:Key="NeutralChipTextStyle">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>