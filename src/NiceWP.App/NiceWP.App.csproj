<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>NiceWP.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\nicewp-app.ico</ApplicationIcon>
    <Platforms>x64;ARM64;x86</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' and Exists('C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\')">C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Microsoft\VisualStudio\v18.0\AppxPackage\</AppxMSBuildToolsPath>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Remove="Assets\Brand\**\*" />
    <Content Include="Assets\Brand\*.ico;Assets\Brand\*.svg;Assets\Brand\nicewp-app-*.png;Assets\Brand\nicewp-tray-*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NiceWP.Core\NiceWP.Core.csproj" />
    <ProjectReference Include="..\NiceWP.Runtime\NiceWP.Runtime.csproj" />
    <ProjectReference Include="..\NiceWP.Infrastructure\NiceWP.Infrastructure.csproj" />
    <ProjectReference Include="..\NiceWP.Runtime.Host\NiceWP.Runtime.Host.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyRuntimeHostToOutput" AfterTargets="Build">
    <ItemGroup>
      <_HostFiles Include="..\NiceWP.Runtime.Host\bin\$(Platform)\$(Configuration)\$(TargetFramework)\NiceWP.Runtime.Host.*" />
      <_HostFiles Condition="'@(_HostFiles)' == ''" Include="..\NiceWP.Runtime.Host\bin\x64\$(Configuration)\$(TargetFramework)\NiceWP.Runtime.Host.*" />
      <_HostFiles Condition="'@(_HostFiles)' == ''" Include="..\NiceWP.Runtime.Host\bin\$(Configuration)\$(TargetFramework)\NiceWP.Runtime.Host.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HostFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
