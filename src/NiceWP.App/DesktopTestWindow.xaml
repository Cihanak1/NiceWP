<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NiceWP.App.DesktopTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NiceWP">
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Auto"
        OpenPaneLength="220"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="960"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnNavigationChanged"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView.PaneHeader>
            <StackPanel Margin="16,14,16,18" Spacing="2">
                <TextBlock Text="NiceWP" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    Text="Wallpaper Manager"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryNavigationItem" Content="Library" Tag="Library" Icon="Pictures" />
            <NavigationViewItem x:Name="ActiveNavigationItem" Content="Active Wallpaper" Tag="Active" Icon="SlideShow" />
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="Settings" Icon="Setting" />
        </NavigationView.MenuItems>

        <Grid Margin="24,18,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- LIBRARY PAGE -->
            <Grid x:Name="LibraryPage" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="LibraryCountText"
                            Text="0 wallpapers in collection"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="AddWallpaperButton"
                        Grid.Column="1"
                        Content="Add Wallpaper"
                        Click="OnAddWallpaper"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <Border
                    x:Name="LibraryEmptyText"
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" MaxWidth="420">
                        <SymbolIcon
                            Symbol="Pictures"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="Your wallpapers, in one place"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Add a local PNG, JPG, or MP4 file to build your wallpaper library and switch backgrounds anytime."
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <GridView
                    x:Name="LibraryListView"
                    Grid.Row="1"
                    SelectionMode="None"
                    Visibility="Collapsed"
                    SizeChanged="OnGallerySizeChanged"
                    Loaded="OnGalleryLoaded"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="256" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Loaded="OnCardBorderLoaded"
                                DataContextChanged="OnCardBorderDataContextChanged"
                                ToolTipService.ToolTip="{Binding ToolTipText}">
                                <StackPanel Spacing="10" Padding="12">
                                    <Grid Height="124" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                        <SymbolIcon
                                            x:Name="CardPlaceholderIcon"
                                            Symbol="Pictures"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image
                                            x:Name="CardPreviewImage"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed" />
                                        <Border
                                            x:Name="CardStateBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Padding="8,3"
                                            CornerRadius="4"
                                            Visibility="Collapsed"
                                            Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                                            <TextBlock
                                                x:Name="CardStateBadgeText"
                                                Text="Missing"
                                                FontSize="11"
                                                FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="3">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding ToolTipText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding Type}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Text="{Binding StatusText}"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Content="Apply"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding CanApply}"
                                            Click="OnApplyWallpaper"
                                            Loaded="OnApplyButtonLoaded"
                                            DataContextChanged="OnApplyButtonDataContextChanged" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Remove"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRemoveWallpaper"
                                            Loaded="OnRemoveButtonLoaded"
                                            DataContextChanged="OnRemoveButtonDataContextChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- ACTIVE WALLPAPER PAGE -->
            <ScrollViewer x:Name="ActivePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Active Wallpaper" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Text="Inspect and control the wallpaper currently rendered by the background runtime host."
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Width="148"
                                    Height="92"
                                    CornerRadius="6"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <SymbolIcon
                                        x:Name="ActivePlaceholderIcon"
                                        Symbol="SlideShow"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image
                                        x:Name="ActivePreviewImage"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="PathText"
                                        Text="No wallpaper"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        x:Name="ActiveFullPathText"
                                        Text="Select a wallpaper from the Library or choose a file below."
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="ActiveMissingWarningText"
                                        Text="Warning: The active wallpaper file could not be found on disk."
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Wallpaper Type"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="WallpaperTypeText"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="None"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Runtime Status"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="PlaybackStatusText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="None"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="SelectImageButton"
                            Content="Choose File..."
                            Click="OnSelectImage"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="PauseResumeWallpaperButton"
                            Content="Pause"
                            Click="OnPauseResumeWallpaper"
                            IsEnabled="False" />
                        <Button
                            x:Name="StopActiveWallpaperButton"
                            Content="Stop Wallpaper"
                            Click="OnStopActiveWallpaper"
                            IsEnabled="False" />
                        <Button
                            x:Name="RefreshActiveStatusButton"
                            Content="Refresh"
                            Click="OnRefreshStatus" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS PAGE -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Configure appearance, Windows startup behavior, and wallpaper session restore."
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Appearance Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Select the color theme applied across all NiceWP screens."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Width="220"
                                SelectionChanged="OnThemeSelectionChanged"
                                AutomationProperties.Name="Application theme">
                                <ComboBoxItem Content="System default" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Startup & Restore Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Startup &amp; Session Restore" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox
                                x:Name="AutostartCheckBox"
                                Content="Start with Windows (launch minimized to system tray)"
                                Checked="OnAutostartChecked"
                                Unchecked="OnAutostartUnchecked" />
                            <CheckBox
                                x:Name="RestoreLastWallpaperCheckBox"
                                Content="Restore last active wallpaper when runtime starts"
                                Checked="OnRestoreLastWallpaperChanged"
                                Unchecked="OnRestoreLastWallpaperChanged" />
                        </StackPanel>
                    </Border>

                    <!-- System Tray & Storage Info Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="System Tray &amp; Local Storage" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Closing this window hides NiceWP to the system tray while your wallpaper continues running with minimal resource usage."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="LibraryStoragePathText"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="SettingsStoragePathText"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="1"
                TextWrapping="Wrap"
                MaxHeight="72"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </NavigationView>
</Window>
