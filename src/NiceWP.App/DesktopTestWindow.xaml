<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NiceWP.App.DesktopTestWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NiceWP">
    <NavigationView
        x:Name="Navigation"
        PaneDisplayMode="Auto"
        OpenPaneLength="220"
        CompactModeThresholdWidth="640"
        ExpandedModeThresholdWidth="960"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnNavigationChanged"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView.PaneHeader>
            <StackPanel Margin="16,16,16,24" Spacing="4">
                <TextBlock Text="NiceWP" FontSize="20" FontWeight="SemiBold" />
                <TextBlock
                    Text="Wallpaper Manager"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryNavigationItem" Content="Library" Tag="Library" Icon="Pictures" />
            <NavigationViewItem x:Name="ActiveNavigationItem" Content="Active Wallpaper" Tag="Active" Icon="SlideShow" />
            <NavigationViewItem x:Name="PerformanceNavigationItem" Content="Performance" Tag="Performance" Icon="ShowResults" />
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="Settings" Icon="Setting" />
        </NavigationView.MenuItems>

        <Grid Margin="24,16,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- LIBRARY PAGE -->
            <Grid x:Name="LibraryPage" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="LibraryCountText"
                            Text="Your wallpaper collection"
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        x:Name="AddWallpaperButton"
                        Grid.Column="1"
                        Content="Add Wallpaper"
                        Click="OnAddWallpaper"
                        VerticalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <!-- Toolbar: Search, Filter, Sort -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                    <TextBox
                        x:Name="LibrarySearchBox"
                        Width="240"
                        PlaceholderText="Search wallpapers"
                        TextChanged="OnSearchTextChanged"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search wallpapers" />
                    <ComboBox
                        x:Name="LibraryFilterComboBox"
                        SelectionChanged="OnFilterSelectionChanged"
                        VerticalAlignment="Center"
                        MinWidth="120"
                        AutomationProperties.Name="Filter wallpapers">
                        <ComboBoxItem Content="All" Tag="All" IsSelected="True" />
                        <ComboBoxItem Content="Images" Tag="Images" />
                        <ComboBoxItem Content="Videos" Tag="Videos" />
                        <ComboBoxItem Content="Favorites" Tag="Favorites" />
                        <ComboBoxItem Content="Recent" Tag="Recent" />
                    </ComboBox>
                    <ComboBox
                        x:Name="LibrarySortComboBox"
                        SelectionChanged="OnSortSelectionChanged"
                        VerticalAlignment="Center"
                        MinWidth="130"
                        AutomationProperties.Name="Sort wallpapers">
                        <ComboBoxItem Content="Newest" Tag="Newest" IsSelected="True" />
                        <ComboBoxItem Content="Oldest" Tag="Oldest" />
                        <ComboBoxItem Content="Name A-Z" Tag="NameAsc" />
                        <ComboBoxItem Content="Name Z-A" Tag="NameDesc" />
                    </ComboBox>
                </StackPanel>

                <Border
                    x:Name="LibraryEmptyText" Visibility="Collapsed"
                    Grid.Row="2"
                    Padding="32"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                        <SymbolIcon
                            Symbol="Pictures"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="EmptyTitleText"
                            Text="No wallpapers in library"
                            FontSize="16"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="EmptySubtitleText"
                            Text="Use Add Wallpaper to add an image or MP4."
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <GridView
                    x:Name="LibraryListView"
                    Grid.Row="2"
                    SelectionMode="None"
                    Visibility="Collapsed"
                    SizeChanged="OnGallerySizeChanged"
                    Loaded="OnGalleryLoaded"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="256" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Loaded="OnCardBorderLoaded"
                                DataContextChanged="OnCardBorderDataContextChanged"
                                ToolTipService.ToolTip="{Binding ToolTipText}">
                                <Border.ContextFlyout>
                                    <MenuFlyout Opening="OnCardMenuFlyoutOpening">
                                        <MenuFlyoutItem x:Name="MenuApplyItem" Text="Apply" Click="OnMenuApplyClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuFavoriteItem" Text="Favorite" Click="OnMenuFavoriteClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon x:Name="MenuFavoriteIcon" Glyph="&#xE734;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuRenameItem" Text="Rename…" Click="OnMenuRenameClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuOpenLocationItem" Text="Open File Location" Click="OnMenuOpenLocationClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED25;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuLocateFileItem" Text="Locate File…" Click="OnMenuLocateFileClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuRemoveItem" Text="Remove" Click="OnMenuRemoveClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel Spacing="12" Padding="12">
                                    <Grid Height="124" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                        <SymbolIcon
                                            x:Name="CardPlaceholderIcon"
                                            Symbol="Pictures"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image
                                            x:Name="CardPreviewImage"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="CardFavoriteButton"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Padding="4"
                                            MinWidth="32"
                                            MinHeight="32"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                            BorderThickness="0"
                                            Click="OnToggleFavorite"
                                            Loaded="OnFavoriteButtonLoaded"
                                            DataContextChanged="OnFavoriteButtonDataContextChanged"
                                            AutomationProperties.Name="Favorite">
                                            <FontIcon
                                                x:Name="CardFavoriteIcon"
                                                Glyph="&#xE734;"
                                                FontSize="14" />
                                        </Button>
                                        <Border
                                            x:Name="CardStateBadge"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="8"
                                            Padding="8,4"
                                            CornerRadius="4"
                                            Visibility="Collapsed"
                                            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                            <TextBlock
                                                x:Name="CardStateBadgeText"
                                                Text="Missing"
                                                FontSize="11"
                                                FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" MinHeight="40" MaxLines="2"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding ToolTipText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                Text="{Binding Type}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="CardApplyButton" Style="{StaticResource AccentButtonStyle}"
                                            Content="Apply"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="{Binding CanApply}"
                                            Click="OnApplyWallpaper"
                                            Loaded="OnApplyButtonLoaded"
                                            DataContextChanged="OnApplyButtonDataContextChanged" />
                                        <Button
                                            x:Name="CardLocateButton" Style="{StaticResource AccentButtonStyle}"
                                            Content="Locate File"
                                            HorizontalAlignment="Stretch"
                                            Visibility="Collapsed"
                                            Click="OnLocateWallpaper"
                                            Loaded="OnLocateButtonLoaded"
                                            DataContextChanged="OnLocateButtonDataContextChanged" />
                                        <Button
                                            x:Name="CardRemoveButton"
                                            Grid.Column="1"
                                            Content="Remove"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRemoveWallpaper"
                                            Loaded="OnRemoveButtonLoaded"
                                            DataContextChanged="OnRemoveButtonDataContextChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>

            <!-- ACTIVE WALLPAPER PAGE -->
            <ScrollViewer x:Name="ActivePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Wallpaper" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock
                            Text="Your current desktop wallpaper."
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="ActiveEmptyState" Spacing="8" Margin="0,16,0,8">
                        <TextBlock Text="No wallpaper active" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Apply a wallpaper from Library or choose a file below." TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="ActiveDetailsPanel" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid
                                    Width="112"
                                    Height="92"
                                    CornerRadius="4"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <SymbolIcon
                                        x:Name="ActivePlaceholderIcon"
                                        Symbol="SlideShow"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image
                                        x:Name="ActivePreviewImage"
                                        Stretch="UniformToFill"
                                        Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="PathText"
                                        Text="No wallpaper active"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="1" />
                                    <TextBlock
                                        x:Name="ActiveFullPathText"
                                        Text="Select a wallpaper from the Library or choose a file below."
                                        FontSize="12"
                                        TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock
                                        x:Name="ActiveMissingWarningText"
                                        Text="The wallpaper file is missing." TextWrapping="Wrap"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Visibility="Collapsed"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Type"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="WallpaperTypeText"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="None"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Status"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="PlaybackStatusText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="None"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="152" ItemHeight="48">
                        <Button
                            x:Name="SelectImageButton"
                            Content="Choose File…"
                            Click="OnSelectImage"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="PauseResumeWallpaperButton"
                            Content="Pause"
                            Click="OnPauseResumeWallpaper"
                            IsEnabled="False" />
                        <Button
                            x:Name="StopActiveWallpaperButton"
                            Content="Stop"
                            Click="OnStopActiveWallpaper"
                            IsEnabled="False" />
                        <Button
                            x:Name="RefreshActiveStatusButton"
                            Content="Refresh"
                            Click="OnRefreshStatus" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- PERFORMANCE PAGE -->
            <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <!-- Header & Action -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Performance" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="PerformanceSubtitleText"
                                Text="Real-time resource utilization and runtime diagnostics."
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                x:Name="ExportReportButton"
                                Content="Export Report"
                                Click="OnExportReportClicked"
                                AutomationProperties.Name="Export performance report" />
                        </StackPanel>
                    </Grid>

                    <!-- Host Status Banner -->
                    <Border
                        x:Name="PerformanceHostStatusBorder"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon x:Name="PerformanceHostStatusIcon" Symbol="ShowResults" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="PerformanceHostStatusTitle" Text="Runtime Host: Connected" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="PerformanceHostStatusDetails" Text="PID: 0 • Uptime: 00:00:00" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="PerformanceLiveIndicator" Text="LIVE (1s)" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- 1. Process & Memory Metrics -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Runtime Process Metrics" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="CPU Utilization" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfCpuCurrentText" Text="--%" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Working Set -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Working Set (RAM)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfWorkingSetText" Text="-- MB" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Private Memory -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Private Memory" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfPrivateMemoryText" Text="-- MB" FontSize="20" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Threads -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Active Threads" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfThreadsText" Text="--" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Handles -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Kernel Handles" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfHandlesText" Text="--" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- Uptime -->
                                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Host Uptime" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfUptimeText" Text="--" FontSize="18" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Last 60 Seconds Stats -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Text="60-Second Short-Term Window" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="PerfSampleCountText" Text="0 samples" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="CPU Average / Peak" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfCpuStatsText" Text="Avg: --% • Peak: --%" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="RAM Average / Peak" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfRamStatsText" Text="Avg: -- MB • Peak: -- MB" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Private Average / Peak" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfPrivateStatsText" Text="Avg: -- MB • Peak: -- MB" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Threads (Peak)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfThreadPeakText" Text="Peak: --" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Handles (Peak)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfHandlePeakText" Text="Peak: --" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. Wallpaper & Rendering Transparency -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Wallpaper &amp; Rendering State" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Active Type &amp; Playback" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfWallpaperTypeStateText" Text="None • Inactive" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Renderer Window (HWND)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfRendererStatusText" Text="Inactive" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Source Resolution" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfSourceResolutionText" Text="Unavailable" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Decode Resolution &amp; Memory" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfDecodeResolutionText" Text="Unavailable" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                                    <TextBlock Text="Media Details" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfMediaDetailsText" Text="None" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 4. Efficiency & Policies -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Efficiency &amp; Host Attachment" FontSize="15" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Desktop Host (WorkerW)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfDesktopHostStateText" Text="Disconnected" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Active Pause Reasons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfPauseReasonsText" Text="None" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Fullscreen Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfFullscreenPolicyText" Text="Inactive" FontSize="13" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Power / Battery Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="PerfPowerPolicyText" Text="Inactive" FontSize="13" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 5. GPU Measurement Status -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="GPU Measurement" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="PerfGpuStatusText"
                                Text="GPU metrics: Unavailable. Windows process-level GPU counters require full D3D engine enumeration across all processes, adding 2+ seconds overhead per sample."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 6. Local Privacy Notice -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="ProtectedDocument" VerticalAlignment="Center" />
                                <TextBlock Text="Privacy &amp; Local Transparency" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                Text="Metrics are measured locally. NiceWP does not send performance telemetry anywhere."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS PAGE -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock
                            Text="Appearance and startup preferences."
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Appearance Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Use light, dark, or your Windows theme."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox
                                x:Name="ThemeComboBox"
                                Width="220"
                                SelectionChanged="OnThemeSelectionChanged"
                                AutomationProperties.Name="Application theme">
                                <ComboBoxItem Content="System default" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Startup & Restore Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Startup &amp; Session Restore" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox
                                x:Name="AutostartCheckBox"
                                Content="Start with Windows"
                                Checked="OnAutostartChecked"
                                Unchecked="OnAutostartUnchecked" />
                            <CheckBox
                                x:Name="RestoreLastWallpaperCheckBox"
                                Content="Restore last wallpaper"
                                Checked="OnRestoreLastWallpaperChanged"
                                Unchecked="OnRestoreLastWallpaperChanged" />
                        </StackPanel>
                    </Border>

                    <!-- System Tray & Storage Info Group -->
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="System Tray &amp; Local Storage" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock
                                Text="NiceWP stays in the system tray when you close this window. Your wallpaper keeps running."
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="LibraryStoragePathText"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="SettingsStoragePathText"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border x:Name="FeedbackArea" Grid.Row="1" Visibility="Collapsed"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="BusyIndicator" Width="16" Height="16" MinWidth="16" MinHeight="16"
                                  IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Working" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="BusyText" Text="Working…" Visibility="Collapsed" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Window>
