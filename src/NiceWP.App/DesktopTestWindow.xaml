                                    <ComboBox x:Name="ScheduleModeComboBox" SelectionChanged="OnScheduleModeSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Schedule mode">
                                        <ComboBoxItem Content="Off" Tag="Off" />
                                        <ComboBoxItem Content="Day &amp; Night" Tag="DayNight" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" x:Name="ScheduleDayStartPanel">
                                    <TextBlock x:Name="SettingsDayStartLabel" Text="Day begins" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ScheduleDayStartComboBox" SelectionChanged="OnScheduleDayStartSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Day start time">
                                        <ComboBoxItem Content="06:00" Tag="06:00" />
                                        <ComboBoxItem Content="07:00" Tag="07:00" />
                                        <ComboBoxItem Content="08:00" Tag="08:00" />
                                        <ComboBoxItem Content="09:00" Tag="09:00" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6" x:Name="ScheduleNightStartPanel">
                                    <TextBlock x:Name="SettingsNightStartLabel" Text="Night begins" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ScheduleNightStartComboBox" SelectionChanged="OnScheduleNightStartSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Night start time">
                                        <ComboBoxItem Content="18:00" Tag="18:00" />
                                        <ComboBoxItem Content="19:00" Tag="19:00" />
                                        <ComboBoxItem Content="20:00" Tag="20:00" />
                                        <ComboBoxItem Content="21:00" Tag="21:00" />
                                        <ComboBoxItem Content="22:00" Tag="22:00" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="16" RowSpacing="12" x:Name="ScheduleWallpapersGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock x:Name="SettingsDayWallpaperLabel" Text="Day wallpaper" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ScheduleDayWallpaperComboBox" SelectionChanged="OnScheduleDayWallpaperSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Day wallpaper" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Name="SettingsNightWallpaperLabel" Text="Night wallpaper" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ScheduleNightWallpaperComboBox" SelectionChanged="OnScheduleNightWallpaperSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Night wallpaper" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ScheduleSettingsStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SettingsAppRulesHeader" Text="Application Rules" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SettingsAppRulesSubtitle" Text="Assign specific desktop profiles or behaviors when selected applications are active." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel x:Name="AppRulesListContainer" Spacing="8" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddAppRuleButton" Content="Add Rule" Click="OnAddAppRuleClicked" />
                                <Button x:Name="AddFromRunningAppButton" Content="Add from Running…" Click="OnAddFromRunningAppClicked" />
                            </StackPanel>
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <TextBlock x:Name="SettingsPresentationWallpaperHeader" Text="Presentation Profile Wallpaper (Optional)" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="SettingsPresentationWallpaperSubtitle" Text="Wallpaper to show during meetings or screen share sessions." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="PresentationWallpaperComboBox" HorizontalAlignment="Stretch" SelectionChanged="OnPresentationWallpaperSelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SettingsAdaptiveHeader" Text="Adaptive Desktop Intelligence" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SettingsAdaptiveSubtitle" Text="Configure automatic behavior profiles and hardware resource limits." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock x:Name="SettingsAdaptiveProfileLabel" Text="Default Profile" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="AdaptiveProfileComboBox" SelectionChanged="OnAdaptiveProfileSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Adaptive profile">
                                        <ComboBoxItem Content="Automatic (Context-aware)" Tag="Automatic" />
                                        <ComboBoxItem Content="Normal" Tag="Normal" />
                                        <ComboBoxItem Content="Focus" Tag="Focus" />
                                        <ComboBoxItem Content="Gaming" Tag="Gaming" />
                                        <ComboBoxItem Content="Presentation" Tag="Presentation" />
                                        <ComboBoxItem Content="Battery Saver" Tag="BatterySaver" />
                                        <ComboBoxItem Content="Cinema" Tag="Cinema" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock x:Name="SettingsResourceBudgetLabel" Text="Resource Budget" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="ResourceBudgetComboBox" SelectionChanged="OnResourceBudgetSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Resource budget">
                                        <ComboBoxItem Content="Automatic (Balanced / Power-aware)" Tag="Automatic" />
                                        <ComboBoxItem Content="Low (Aggressive savings)" Tag="Low" />
                                        <ComboBoxItem Content="Balanced (Recommended)" Tag="Balanced" />
                                        <ComboBoxItem Content="High (High performance)" Tag="High" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AdaptiveSettingsStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="SettingsStorageHeader" Text="System Tray &amp; Local Storage" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="SettingsStorageSubtitle" Text="NiceWP stays in the system tray when you close this window. Your wallpaper keeps running." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LibraryStoragePathText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SettingsStoragePathText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FeedbackArea" Grid.Row="1" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="BusyIndicator" Width="16" Height="16" MinWidth="16" MinHeight="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Working" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="BusyText" Text="Working…" Visibility="Collapsed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Window>