<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NiceWP.App.DesktopTestWindow" Title="NiceWP">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="208" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="960" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigationChanged" Background="{ThemeResource ControlCanvasBrush}">
        <NavigationView.Resources>
            <Style TargetType="NavigationViewItem">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <DataTemplate x:Key="RemoteImportTemplate">
                <StackPanel Spacing="16" MaxWidth="480">
                    <TextBlock Text="Paste a direct media or supported wallpaper page URL." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="RemoteUrlBox" Header="Wallpaper URL" PlaceholderText="https://…" HorizontalAlignment="Stretch" AutomationProperties.Name="Wallpaper URL" />
                    <CheckBox x:Name="RemoteApplyCheckBox" Content="Apply after download" IsChecked="True" />
                    <StackPanel Spacing="8">
                        <ProgressBar x:Name="RemoteProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Download progress" />
                        <Grid>
                            <TextBlock x:Name="RemoteStatusText" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="RemoteErrorText" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                        </Grid>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Downloaded locally and validated before use." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="NiceWP only accesses the network when you explicitly import a remote wallpaper." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <StackPanel Margin="16,16,16,16" Spacing="8">
                <Border Width="24" Height="2" HorizontalAlignment="Left" Background="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="NiceWP" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" CharacterSpacing="-20" />
                <TextBlock Text="DESKTOP CONTROL" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" CharacterSpacing="100" />
            </StackPanel>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryNavigationItem" Content="Library" Tag="Library" Icon="Pictures" />
            <NavigationViewItem x:Name="ActiveNavigationItem" Content="Active Wallpaper" Tag="Active" Icon="SlideShow" />
            <NavigationViewItem x:Name="PerformanceNavigationItem" Content="Performance" Tag="Performance" Icon="ShowResults" />
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="Settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid Margin="24,16,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="LibraryPage" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" FontSize="32" />
                        <TextBlock x:Name="LibraryCountText" Text="Your wallpaper collection" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Padding="12,12,4,4" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="44" ItemWidth="160" SizeChanged="OnResponsivePanelSizeChanged" x:Name="LibraryControlStrip">
                        <TextBox x:Name="LibrarySearchBox" PlaceholderText="Search wallpapers" TextChanged="OnSearchTextChanged" VerticalAlignment="Center" AutomationProperties.Name="Search wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" VariableSizedWrapGrid.ColumnSpan="2" />
                        <ComboBox x:Name="LibraryFilterComboBox" SelectionChanged="OnFilterSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Filter wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTipService.ToolTip="Filter collection">
                            <ComboBoxItem Content="All" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="Images" Tag="Images" />
                            <ComboBoxItem Content="Videos" Tag="Videos" />
                            <ComboBoxItem Content="Favorites" Tag="Favorites" />
                            <ComboBoxItem Content="Recent" Tag="Recent" />
                        </ComboBox>
                        <ComboBox x:Name="LibrarySortComboBox" SelectionChanged="OnSortSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Sort wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTipService.ToolTip="Sort collection">
                            <ComboBoxItem Content="Newest" Tag="Newest" IsSelected="True" />
                            <ComboBoxItem Content="Oldest" Tag="Oldest" />
                            <ComboBoxItem Content="Name A-Z" Tag="NameAsc" />
                            <ComboBoxItem Content="Name Z-A" Tag="NameDesc" />
                        </ComboBox>
                        <Button x:Name="AddWallpaperButton" Content="Add Wallpaper" Click="OnAddWallpaper" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button x:Name="AddFromUrlButton" Content="Add from URL" Click="OnAddFromUrlClicked" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </VariableSizedWrapGrid>
                </Border>
                <Border x:Name="LibraryEmptyText" Visibility="Collapsed" Grid.Row="2" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,8,0,0">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                        <SymbolIcon Symbol="Pictures" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitleText" Text="No wallpapers in library" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptySubtitleText" Text="Use Add Wallpaper or Add from URL to add an image or MP4." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <GridView x:Name="LibraryListView" Grid.Row="2" SelectionMode="None" Visibility="Collapsed" SizeChanged="OnGallerySizeChanged" Loaded="OnGalleryLoaded" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="256" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource LibraryCardSurfaceBrush}" BorderBrush="{ThemeResource LibraryCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Loaded="OnCardBorderLoaded" DataContextChanged="OnCardBorderDataContextChanged" ToolTipService.ToolTip="{Binding ToolTipText}">
                                <Border.ContextFlyout>
                                    <MenuFlyout Opening="OnCardMenuFlyoutOpening">
                                        <MenuFlyoutItem x:Name="MenuApplyItem" Text="Apply" Click="OnMenuApplyClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuFavoriteItem" Text="Favorite" Click="OnMenuFavoriteClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon x:Name="MenuFavoriteIcon" Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuRenameItem" Text="Rename…" Click="OnMenuRenameClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuOpenLocationItem" Text="Open File Location" Click="OnMenuOpenLocationClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuLocateFileItem" Text="Locate File…" Click="OnMenuLocateFileClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuRemoveItem" Text="Remove" Click="OnMenuRemoveClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel Spacing="12" Padding="0">
                                    <Grid Height="200" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" SizeChanged="OnCardPreviewSizeChanged">
                                        <SymbolIcon x:Name="CardPlaceholderIcon" Symbol="Pictures" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="CardPreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        <Button x:Name="CardFavoriteButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="4" MinWidth="32" MinHeight="32" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" Click="OnToggleFavorite" Loaded="OnFavoriteButtonLoaded" DataContextChanged="OnFavoriteButtonDataContextChanged" AutomationProperties.Name="Favorite" BorderBrush="{ThemeResource ControlStrokeBrush}">
                                            <FontIcon x:Name="CardFavoriteIcon" Glyph="" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Button>
                                        <Border x:Name="CardStateBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,4" CornerRadius="4" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                            <TextBlock x:Name="CardStateBadgeText" Text="Missing" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" CharacterSpacing="60" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="8" Margin="16,0,16,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="44" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ToolTipText}" FontSize="16" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Padding="8,4" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" CharacterSpacing="40" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" Margin="16,0,16,16" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ControlStrokeBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CardApplyButton" Style="{StaticResource AccentButtonStyle}" Content="Apply" HorizontalAlignment="Left" IsEnabled="{Binding CanApply}" Click="OnApplyWallpaper" Loaded="OnApplyButtonLoaded" DataContextChanged="OnApplyButtonDataContextChanged" MinWidth="104" />
                                        <Button x:Name="CardLocateButton" Content="Locate File" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnLocateWallpaper" Loaded="OnLocateButtonLoaded" DataContextChanged="OnLocateButtonDataContextChanged" />
                                        <Button x:Name="CardRemoveButton" Grid.Column="1" Content="Remove" HorizontalAlignment="Stretch" Click="OnRemoveWallpaper" Loaded="OnRemoveButtonLoaded" DataContextChanged="OnRemoveButtonDataContextChanged" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Remove from library" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
            <ScrollViewer x:Name="ActivePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Active Wallpaper" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Your current desktop wallpaper." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="ActiveEmptyState" Spacing="8" Margin="0,16,0,8">
                        <TextBlock Text="No wallpaper active" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Apply a wallpaper from Library or choose a file below." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="ActiveDetailsPanel" Visibility="Collapsed" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="16">
                                <Grid Height="240" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" HorizontalAlignment="Stretch">
                                    <SymbolIcon x:Name="ActivePlaceholderIcon" Symbol="SlideShow" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Image x:Name="ActivePreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="PathText" Text="No wallpaper active" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ActiveFullPathText" Text="Select a wallpaper from the Library or choose a file below." FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ActiveMissingWarningText" Text="The wallpaper file is missing." TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Grid ColumnSpacing="24" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="WallpaperTypeText" Grid.Row="0" Grid.Column="1" Text="None" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlaybackStatusText" Grid.Row="1" Grid.Column="1" Text="None" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Efficiency" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedItem.Tag, ElementName=EfficiencyProfileComboBox}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Source resolution · last measurement" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Available in Performance" TextWrapping="Wrap" x:Name="ActiveResolutionText" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="Rotation &amp; Playlist" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveRotationStateText" Text="Rotation: Off" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock x:Name="ActiveRotationPositionText" Text="Position: - / -" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveRotationCountdownText" Text="Next change: Inactive" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="136" ItemHeight="44">
                        <Button x:Name="PreviousWallpaperButton" Content="Previous" Click="OnPreviousWallpaperClicked" AutomationProperties.Name="Previous wallpaper" ToolTipService.ToolTip="Previous wallpaper" />
                        <Button x:Name="PauseResumeWallpaperButton" Content="Pause" Click="OnPauseResumeWallpaper" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="NextWallpaperButton" Content="Next" Click="OnNextWallpaperClicked" AutomationProperties.Name="Next wallpaper" ToolTipService.ToolTip="Next wallpaper" />
                        <Button x:Name="StopActiveWallpaperButton" Content="Stop" Click="OnStopActiveWallpaper" IsEnabled="False" />
                        <Button x:Name="SelectImageButton" Content="Choose File…" Click="OnSelectImage" />
                        <Button x:Name="RefreshActiveStatusButton" Content="Refresh" Click="OnRefreshStatus" />
                    </VariableSizedWrapGrid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Performance" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PerformanceSubtitleText" Text="A clear view of your desktop. Metrics stay on this device." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ExportReportButton" Content="Export Report" Click="OnExportReportClicked" AutomationProperties.Name="Export performance report" />
                        </StackPanel>
                    </Grid>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="136" SizeChanged="OnResponsivePanelSizeChanged" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Runtime Health" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfRuntimeHealthText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Efficiency Mode" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfEfficiencyProfileText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Current Action" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfCurrentActionText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </VariableSizedWrapGrid>
                    <Border x:Name="PerformanceHostStatusBorder" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon x:Name="PerformanceHostStatusIcon" Symbol="ShowResults" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <TextBlock x:Name="PerformanceHostStatusTitle" Text="Waiting for runtime" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerformanceHostStatusDetails" Text="Status appears when the runtime responds." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="PerformanceLiveIndicator" Text="LIVE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="144" SizeChanged="OnResponsivePanelSizeChanged" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="CPU" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfCpuCurrentText" Text="--%" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfCpuStatsText" Text="Avg: --% • Peak: --%" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Memory · working set" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfWorkingSetText" Text="-- MB" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfRamStatsText" Text="Avg: -- MB • Peak: -- MB" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Private Memory" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfPrivateMemoryText" Text="-- MB" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfPrivateStatsText" Text="Avg: -- MB • Peak: -- MB" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Threads" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfThreadsText" Text="--" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfThreadPeakText" Text="Peak: --" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Handles" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfHandlesText" Text="--" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfHandlePeakText" Text="Peak: --" FontSize="12" FontWeight="Normal" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Uptime" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfUptimeText" Text="--" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerfSampleCountText" Text="0 samples" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="Normal" />
                            </StackPanel>
                        </Border>
                    </VariableSizedWrapGrid>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Wallpaper &amp; Renderer" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Active Type &amp; Playback" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfWallpaperTypeStateText" Text="None • Inactive" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Renderer Window (HWND)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfRendererStatusText" Text="Inactive" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Source Resolution" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfSourceResolutionText" Text="Unavailable" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Decode Resolution &amp; Memory" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfDecodeResolutionText" Text="Unavailable" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                    <TextBlock Text="Media Details" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfMediaDetailsText" Text="None" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Desktop guardrails" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <Border x:Name="PerfEfficiencyStatusBadge" HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock x:Name="PerfEfficiencyStatusText" Text="Efficiency: Active" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Desktop Host (WorkerW)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfDesktopHostStateText" Text="Disconnected" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Active Pause Reasons" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfPauseReasonsText" Text="None" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Fullscreen Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfFullscreenPolicyText" Text="Inactive" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Power / Battery Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfPowerPolicyText" Text="Inactive" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Session Lock Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfSessionLockPolicyText" Text="Inactive" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Display Power Policy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PerfDisplayPowerPolicyText" Text="Inactive" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Audit Trail" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock x:Name="PerfRecentEventsCountText" Text="0 events" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border BorderThickness="2,0,0,0" BorderBrush="{ThemeResource ControlStrokeBrush}" Padding="16,0,0,0">
                                <TextBlock x:Name="PerfRecentEventsListText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No events recorded." LineHeight="24" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="GPU Measurement" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PerfGpuStatusText" Text="GPU metrics: Unavailable. Windows process-level GPU counters require full D3D engine enumeration across all processes, adding 2+ seconds overhead per sample." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="ProtectedDocument" VerticalAlignment="Center" />
                                <TextBlock Text="Privacy &amp; Local Transparency" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="Metrics stay on this device. No performance telemetry is sent." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Appearance and startup preferences." FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Use light, dark, or your Windows theme." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="ThemeComboBox" SelectionChanged="OnThemeSelectionChanged" AutomationProperties.Name="Application theme" MaxWidth="280" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="System default" Tag="System" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Efficiency" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Control how NiceWP balances visual smoothness with background battery and CPU efficiency." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="EfficiencyProfileComboBox" SelectionChanged="OnEfficiencyProfileSelectionChanged" AutomationProperties.Name="Efficiency mode" HorizontalAlignment="Stretch" MaxWidth="560">
                                <ComboBoxItem Tag="Balanced">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Balanced · Recommended" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="Balanced desktop performance and background savings" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Eco">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Eco" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="Maximum background savings" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Unrestricted">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Unrestricted" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="Keeps wallpaper running whenever possible" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="EfficiencyProfileDescriptionText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Startup" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <CheckBox x:Name="AutostartCheckBox" Content="Start with Windows" Checked="OnAutostartChecked" Unchecked="OnAutostartUnchecked" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ControlSurfaceStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Wallpaper Behavior" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                            <CheckBox x:Name="RestoreLastWallpaperCheckBox" Content="Restore last wallpaper" Checked="OnRestoreLastWallpaperChanged" Unchecked="OnRestoreLastWallpaperChanged" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Wallpaper Rotation" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Automatically cycle through wallpapers in your library or favorites." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Rotation" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="RotationModeComboBox" SelectionChanged="OnRotationModeSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Rotation mode">
                                        <ComboBoxItem Content="Off" Tag="Off" />
                                        <ComboBoxItem Content="All Library" Tag="All" />
                                        <ComboBoxItem Content="Favorites" Tag="Favorites" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Order" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="RotationOrderComboBox" SelectionChanged="OnRotationOrderSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Rotation order">
                                        <ComboBoxItem Content="Sequential" Tag="Sequential" />
                                        <ComboBoxItem Content="Shuffle" Tag="Shuffle" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Change every" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="RotationIntervalComboBox" SelectionChanged="OnRotationIntervalSelectionChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="Rotation interval">
                                        <ComboBoxItem Content="5 minutes" Tag="5" />
                                        <ComboBoxItem Content="15 minutes" Tag="15" />
                                        <ComboBoxItem Content="30 minutes" Tag="30" />
                                        <ComboBoxItem Content="1 hour" Tag="60" />
                                        <ComboBoxItem Content="3 hours" Tag="180" />
                                        <ComboBoxItem Content="6 hours" Tag="360" />
                                        <ComboBoxItem Content="12 hours" Tag="720" />
                                        <ComboBoxItem Content="24 hours" Tag="1440" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="RotationSettingsStatusText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="System Tray &amp; Local Storage" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="NiceWP stays in the system tray when you close this window. Your wallpaper keeps running." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LibraryStoragePathText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="SettingsStoragePathText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="FeedbackArea" Grid.Row="1" Visibility="Collapsed" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="BusyIndicator" Width="16" Height="16" MinWidth="16" MinHeight="16" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Working" />
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="BusyText" Text="Working…" Visibility="Collapsed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                        <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </NavigationView>
</Window>