<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NiceWP.App.DesktopTestWindow" Title="NiceWP">
    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="208" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="960" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigationChanged" Background="{ThemeResource ControlCanvasBrush}">
        <NavigationView.Resources>
            <Style TargetType="NavigationViewItem">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Margin" Value="0,2,0,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <DataTemplate x:Key="RemoteImportTemplate">
                <StackPanel Spacing="16" MaxWidth="480">
                    <TextBlock x:Name="RemoteInstructionsText" Text="Paste a direct media or supported wallpaper page URL." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="RemoteUrlBox" Header="Wallpaper URL" PlaceholderText="https://…" HorizontalAlignment="Stretch" AutomationProperties.Name="Wallpaper URL" />
                    <CheckBox x:Name="RemoteApplyCheckBox" Content="Apply after download" IsChecked="True" />
                    <StackPanel Spacing="8">
                        <ProgressBar x:Name="RemoteProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="Download progress" />
                        <Grid>
                            <TextBlock x:Name="RemoteStatusText" FontSize="13" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="RemoteErrorText" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                        </Grid>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="RemoteSecurityHeader" Text="Downloaded locally and validated before use." FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="RemoteSecurityText" Text="NiceWP only accesses the network when you explicitly import a remote wallpaper." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </NavigationView.Resources>
        <NavigationView.PaneHeader>
            <Grid Margin="16,16,16,16" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="32" Height="32" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                    <Image.Source>
                        <SvgImageSource UriSource="ms-appx:///Assets/Brand/nicewp-app.svg" />
                    </Image.Source>
                </Image>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="NiceWP" FontSize="22" FontWeight="SemiBold" CharacterSpacing="-20" />
                    <TextBlock x:Name="AppTaglineText" Text="DESKTOP CONTROL" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" CharacterSpacing="100" />
                </StackPanel>
            </Grid>
        </NavigationView.PaneHeader>
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="LibraryNavigationItem" Content="Library" Tag="Library" Icon="Pictures" />
            <NavigationViewItem x:Name="ActiveNavigationItem" Content="Active Wallpaper" Tag="Active" Icon="SlideShow" />
            <NavigationViewItem x:Name="PerformanceNavigationItem" Content="Performance" Tag="Performance" Icon="ShowResults" />
            <NavigationViewItem x:Name="SettingsNavigationItem" Content="Settings" Tag="Settings" Icon="Setting" />
        </NavigationView.MenuItems>
        <Grid Margin="24,16,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="LibraryPage" RowSpacing="12" AllowDrop="True" DragOver="OnLibraryDragOver" DragLeave="OnLibraryDragLeave" Drop="OnLibraryDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="LibraryTitleText" Text="Library" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" FontSize="32" />
                        <TextBlock x:Name="LibraryCountText" Text="Your wallpaper collection" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Padding="12,12,4,4" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="44" ItemWidth="160" SizeChanged="OnResponsivePanelSizeChanged" x:Name="LibraryControlStrip">
                        <TextBox x:Name="LibrarySearchBox" PlaceholderText="Search wallpapers" TextChanged="OnSearchTextChanged" VerticalAlignment="Center" AutomationProperties.Name="Search wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" VariableSizedWrapGrid.ColumnSpan="2" />
                        <ComboBox x:Name="LibraryFilterComboBox" SelectionChanged="OnFilterSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Filter wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTipService.ToolTip="Filter collection">
                            <ComboBoxItem Content="All" Tag="All" IsSelected="True" />
                            <ComboBoxItem Content="Images" Tag="Images" />
                            <ComboBoxItem Content="Videos" Tag="Videos" />
                            <ComboBoxItem Content="Favorites" Tag="Favorites" />
                            <ComboBoxItem Content="Recent" Tag="Recent" />
                        </ComboBox>
                        <ComboBox x:Name="LibrarySortComboBox" SelectionChanged="OnSortSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Sort wallpapers" HorizontalAlignment="Stretch" Margin="0,0,8,8" ToolTipService.ToolTip="Sort collection">
                            <ComboBoxItem Content="Newest" Tag="Newest" IsSelected="True" />
                            <ComboBoxItem Content="Oldest" Tag="Oldest" />
                            <ComboBoxItem Content="Name A-Z" Tag="NameAsc" />
                            <ComboBoxItem Content="Name Z-A" Tag="NameDesc" />
                        </ComboBox>
                        <Button x:Name="AddWallpaperButton" Content="Add Wallpaper" Click="OnAddWallpaper" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button x:Name="AddFolderButton" Content="Add Folder" Click="OnAddFolderClicked" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTipService.ToolTip="Import all wallpapers from a folder" />
                        <Button x:Name="AddFromUrlButton" Content="Add from URL" Click="OnAddFromUrlClicked" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <Button x:Name="SelectModeButton" Content="Select" Click="OnToggleSelectModeClicked" Margin="0,0,8,8" HorizontalAlignment="Stretch" VerticalAlignment="Center" ToolTipService.ToolTip="Select multiple wallpapers" />
                    </VariableSizedWrapGrid>
                </Border>
                <Border x:Name="BulkActionStrip" Visibility="Collapsed" Grid.Row="2" Padding="12,8" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BulkSelectAllButton" Content="Select All" Click="OnBulkSelectAllClicked" />
                        <Button x:Name="BulkClearSelectionButton" Content="Clear" Click="OnBulkClearSelectionClicked" />
                        <Border Width="1" Height="20" Background="{ThemeResource ControlStrokeBrush}" Margin="4,0" />
                        <Button x:Name="BulkFavoriteButton" Content="Favorite" Click="OnBulkFavoriteClicked" ToolTipService.ToolTip="Add selected to favorites" />
                        <Button x:Name="BulkUnfavoriteButton" Content="Unfavorite" Click="OnBulkUnfavoriteClicked" ToolTipService.ToolTip="Remove selected from favorites" />
                        <Button x:Name="BulkRemoveButton" Content="Remove" Click="OnBulkRemoveClicked" Style="{StaticResource SubtleButtonStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="Remove selected from library" />
                        <Border Width="1" Height="20" Background="{ThemeResource ControlStrokeBrush}" Margin="4,0" />
                        <Button x:Name="BulkDoneButton" Content="Done" Click="OnBulkDoneClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="LibraryEmptyText" Visibility="Collapsed" Grid.Row="3" Padding="32" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,8,0,0">
                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                        <SymbolIcon Symbol="Pictures" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EmptyTitleText" Text="No wallpapers in library" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="EmptySubtitleText" Text="Use Add Wallpaper or Add from URL to add an image or MP4." HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <GridView x:Name="LibraryListView" Grid.Row="3" SelectionMode="None" Visibility="Collapsed" SizeChanged="OnGallerySizeChanged" Loaded="OnGalleryLoaded" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="256" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,12,12" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource LibraryCardSurfaceBrush}" BorderBrush="{ThemeResource LibraryCardStrokeBrush}" BorderThickness="1" CornerRadius="8" Loaded="OnCardBorderLoaded" DataContextChanged="OnCardBorderDataContextChanged" ToolTipService.ToolTip="{Binding ToolTipText}">
                                <Border.ContextFlyout>
                                    <MenuFlyout Opening="OnCardMenuFlyoutOpening">
                                        <MenuFlyoutItem x:Name="MenuApplyItem" Text="Apply" Click="OnMenuApplyClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuFavoriteItem" Text="Favorite" Click="OnMenuFavoriteClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon x:Name="MenuFavoriteIcon" Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuRenameItem" Text="Rename…" Click="OnMenuRenameClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuOpenLocationItem" Text="Open File Location" Click="OnMenuOpenLocationClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MenuLocateFileItem" Text="Locate File…" Click="OnMenuLocateFileClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="MenuRemoveItem" Text="Remove" Click="OnMenuRemoveClick">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="" FontSize="14" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel Spacing="12" Padding="0">
                                    <Grid Height="200" CornerRadius="6" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" SizeChanged="OnCardPreviewSizeChanged">
                                        <SymbolIcon x:Name="CardPlaceholderIcon" Symbol="Pictures" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="CardPreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                        <Button x:Name="CardFavoriteButton" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="4" MinWidth="32" MinHeight="32" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="1" Click="OnToggleFavorite" Loaded="OnFavoriteButtonLoaded" DataContextChanged="OnFavoriteButtonDataContextChanged" AutomationProperties.Name="Favorite" BorderBrush="{ThemeResource ControlStrokeBrush}">
                                            <FontIcon x:Name="CardFavoriteIcon" Glyph="" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Button>
                                        <CheckBox x:Name="CardSelectCheckBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed" Click="OnCardSelectCheckBoxClicked" Loaded="OnCardSelectCheckBoxLoaded" DataContextChanged="OnCardSelectCheckBoxDataContextChanged" AutomationProperties.Name="Select wallpaper" />
                                        <Border x:Name="CardStateBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,48,12,12" Padding="8,4" CornerRadius="4" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                                            <TextBlock x:Name="CardStateBadgeText" Text="Missing" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" CharacterSpacing="60" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Spacing="8" Margin="16,0,16,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="44" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ToolTipText}" FontSize="16" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Padding="8,4" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" CharacterSpacing="40" />
                                            </Border>
                                            <Border x:Name="CardCostBadge" Padding="8,4" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                                <TextBlock x:Name="CardCostBadgeText" Text="{Binding CostLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" CharacterSpacing="40" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" Margin="16,0,16,16" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource ControlStrokeBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CardApplyButton" Style="{StaticResource AccentButtonStyle}" Content="Apply" HorizontalAlignment="Left" IsEnabled="{Binding CanApply}" Click="OnApplyWallpaper" Loaded="OnApplyButtonLoaded" DataContextChanged="OnApplyButtonDataContextChanged" MinWidth="104" />
                                        <Button x:Name="CardLocateButton" Content="Locate File" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnLocateWallpaper" Loaded="OnLocateButtonLoaded" DataContextChanged="OnLocateButtonDataContextChanged" />
                                        <Button x:Name="CardRemoveButton" Grid.Column="1" Content="Remove" HorizontalAlignment="Stretch" Click="OnRemoveWallpaper" Loaded="OnRemoveButtonLoaded" DataContextChanged="OnRemoveButtonDataContextChanged" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="Remove from library" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
                <Border x:Name="DropOverlayBorder" Grid.RowSpan="4" Visibility="Collapsed" Background="#E618181B" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="12" Margin="-8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Canvas.ZIndex="999" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="DropOverlayTitleText" Text="Drop wallpapers here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock x:Name="DropOverlaySubtitleText" Text="Images (.png, .jpg) and videos (.mp4) supported" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer x:Name="ActivePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnActiveLayoutSizeChanged" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" MaxWidth="1120" HorizontalAlignment="Stretch" x:Name="ActiveContentPanel">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="ActiveWallpaperTitleText" Text="Active Wallpaper" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ActiveEmptyState" Spacing="8" Margin="0,16,0,8">
                        <TextBlock x:Name="ActiveEmptyTitleText" Text="No wallpaper active" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ActiveEmptySubtitleText" Text="Apply a wallpaper from Library or choose a file below." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="ActiveDetailsPanel" Visibility="Collapsed" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="PathText" Text="No wallpaper active" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="WallpaperTypeText" Text="None" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PlaybackStatusText" Text="None" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveEfficiencyProfileText" Text="Balanced" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveWallpaperCostText" Text="Light" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveAdaptiveProfileText" Text="Profile: Auto" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ActiveFullPathText" Text="Select a wallpaper from the Library or choose a file below." FontSize="12" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="ActiveMissingWarningText" Text="The wallpaper file is missing." TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="112" ItemHeight="44">
                        <Button x:Name="PreviousWallpaperButton" Content="Previous" Click="OnPreviousWallpaperClicked" AutomationProperties.Name="Previous wallpaper" ToolTipService.ToolTip="Previous wallpaper" Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                        <Button x:Name="PauseResumeWallpaperButton" Content="Pause" Click="OnPauseResumeWallpaper" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                        <Button x:Name="NextWallpaperButton" Content="Next" Click="OnNextWallpaperClicked" AutomationProperties.Name="Next wallpaper" ToolTipService.ToolTip="Next wallpaper" Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                        <Button x:Name="StopActiveWallpaperButton" Content="Stop" Click="OnStopActiveWallpaper" IsEnabled="False" Margin="0,0,8,8" HorizontalAlignment="Stretch" />
                    </VariableSizedWrapGrid>
                    <Grid ColumnSpacing="16" RowSpacing="8" Visibility="{Binding Visibility, ElementName=ActiveDetailsPanel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ActiveRotationStateText" Text="Rotation: Off" TextWrapping="Wrap" FontWeight="SemiBold" Grid.Row="0" Grid.ColumnSpan="2" FontSize="12" />
                        <TextBlock x:Name="ActiveRotationPositionText" Text="Position: - / -" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1" />
                        <TextBlock x:Name="ActiveRotationCountdownText" Text="Next change: Inactive" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="1" Grid.Column="1" />
                        <TextBlock x:Name="ActiveScheduleStateText" Text="Schedule: Off" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Grid.Row="2" Grid.ColumnSpan="2" />
                    </Grid>
                    <Grid Height="200" CornerRadius="4" Background="{ThemeResource ControlAltFillColorSecondaryBrush}" HorizontalAlignment="Left" x:Name="ActivePreviewFrame" Width="356" MaxHeight="360" Visibility="{Binding Visibility, ElementName=ActiveDetailsPanel}">
                        <SymbolIcon x:Name="ActivePlaceholderIcon" Symbol="SlideShow" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image x:Name="ActivePreviewImage" Stretch="UniformToFill" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Spacing="8" Visibility="{Binding Visibility, ElementName=ActiveDetailsPanel}">
                        <TextBlock x:Name="ActiveSourceResolutionHeader" Text="Source resolution · last measurement" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Available in Performance" TextWrapping="Wrap" x:Name="ActiveResolutionText" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SelectImageButton" Content="Choose File…" Click="OnSelectImage" />
                        <Button x:Name="RefreshActiveStatusButton" Content="Refresh" Click="OnRefreshStatus" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PerformancePage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="PerformanceTitleText" Text="Performance" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="PerformanceSubtitleText" Text="A clear view of your desktop. Metrics stay on this device." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="ExportReportButton" Content="Export Report" Click="OnExportReportClicked" AutomationProperties.Name="Export performance report" />
                        </StackPanel>
                    </Grid>
                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="240" ItemHeight="136" SizeChanged="OnResponsivePanelSizeChanged" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PerfRuntimeHealthLabel" Text="Runtime Health" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfRuntimeHealthText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PerfEfficiencyModeLabel" Text="Efficiency Mode" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfEfficiencyProfileText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ControlSurfaceStyle}" Margin="0,0,12,12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="PerfCurrentActionLabel" Text="Current Action" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="PerfCurrentActionText" Text="Awaiting status" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </VariableSizedWrapGrid>
                    <Border x:Name="PerformanceHostStatusBorder" Background="{ThemeResource ControlSurfaceBrush}" BorderBrush="{ThemeResource ControlStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon x:Name="PerformanceHostStatusIcon" Symbol="ShowResults" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <TextBlock x:Name="PerformanceHostStatusTitle" Text="Waiting for runtime" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="PerformanceHostStatusDetails" Text="Status appears when the runtime responds." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" x:Name="PerformanceLiveIndicator" Text="LIVE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </Grid>
                    </Border>
